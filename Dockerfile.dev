# 开发环境 Dockerfile
FROM openjdk:17-jdk-slim

# 安装调试工具
RUN apt-get update && apt-get install -y \
    curl \
    telnet \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制 JAR 文件
COPY target/*.jar app.jar

# 创建日志目录
RUN mkdir -p /var/log/index

# 暴露端口
EXPOSE 8080 5005

# 启动应用（支持调试）
ENTRYPOINT ["java", "-jar", "app.jar"]

# 环境变量示例文件
# 复制为 .env 并根据实际环境修改

# 数据库配置
DB_HOST=localhost
DB_PORT=1521
DB_SID=XE
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Elasticsearch 配置
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_CLUSTER=elasticsearch

# GetQuick 配置
GQ_URL=http://localhost:8080
GQ_USERNAME=admin
GQ_PASSWORD=admin123

# 业务配置
DATA_TABLE=business_data
DELTA_TABLE=business_data_changelog
TIME_COLUMN=updated_at
INDEX_NAME=prod_index
GQ_INDEX=prod_gq_index

# 调度配置
FULL_INDEX_CRON=0 0 3 ? * SUN
INCREMENTAL_INDEX_CRON=0 */5 * * * ?

# 性能配置
CHUNK_SIZE=1000
THREADS=8
PARTITIONS=8
